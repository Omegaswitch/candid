# Candid — environment variables. Names only; never commit values.
# Local development: copy to .env.local (and .env for scripts/tests), fill in, see README "Local setup".

# --- Database (Neon PostgreSQL) -------------------------------------------------
# Pooled connection string (host contains "-pooler") — used by the app.
DATABASE_URL=
# Direct (non-pooled) connection string — used by migrations.
DATABASE_URL_UNPOOLED=
# Optional: pool size per server instance (default 5).
DATABASE_POOL_MAX=
# Tests only: a disposable database (integration tests migrate it and write to it).
TEST_DATABASE_URL=

# --- Authentication (Clerk) -----------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Comma-separated emails allowed to bootstrap as the first admin on first sign-in (verified email).
BOOTSTRAP_ADMIN_EMAILS=
# Optional display name of the shared workspace (default "Candid").
WORKSPACE_NAME=
# Local development/tests only: "dev" swaps Clerk for a seeded-user picker. Refuses to run on Vercel.
AUTH_MODE=

# --- Private document storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2) ---
# "s3" in production; "local" is a development stand-in that refuses to run on Vercel.
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# local driver only (default .storage)
LOCAL_STORAGE_DIR=

# --- Google Sheets (OAuth) — see docs/google-oauth.md ---------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin, no trailing slash. OAuth redirect = ${APP_URL}/api/google/callback
APP_URL=

# --- Secrets --------------------------------------------------------------------
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts Google tokens at rest and signs
# OAuth state and local-storage links. Rotating it disconnects Google accounts.
TOKEN_ENCRYPTION_KEY=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/purge-documents.
CRON_SECRET=
