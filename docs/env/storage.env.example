# Document storage (src/server/storage.ts). Copy the names you need into the environment; never commit values.

# "s3" (production: any S3-compatible PRIVATE bucket — Cloudflare R2, AWS S3, Backblaze B2)
# or "local" (development stand-in; refuses to run when VERCEL_ENV is set).
STORAGE_DRIVER=

# --- s3 driver ---------------------------------------------------------------
# Bucket name. Keep it private (no public access). The browser uploads straight to it with a
# presigned POST, so the bucket needs a CORS rule allowing POST from the app's origin
# (and GET if you want to fetch objects from scripts; downloads are plain redirects).
S3_BUCKET=
# Region; "auto" (default) for Cloudflare R2.
S3_REGION=
# Custom endpoint for non-AWS providers, e.g. https://<account-id>.r2.cloudflarestorage.com
# (leave empty for AWS S3). When set, path-style addressing is used.
S3_ENDPOINT=
# Access key with s3:PutObject, s3:GetObject, s3:DeleteObject on this bucket only.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- local driver ------------------------------------------------------------
# Directory for stored files (default ".storage", git-ignored). Served only through
# /api/storage-local/* with HMAC-signed, expiring tokens — never a public folder.
LOCAL_STORAGE_DIR=
# Also used to sign the local driver's upload/download tokens (shared with the integrations feature).
TOKEN_ENCRYPTION_KEY=

# --- maintenance -------------------------------------------------------------
# purgeRemovedDocuments() in src/server/documents.ts deletes objects of documents removed more than
# 7 days ago and abandoned uploads. Nothing runs it automatically: call it from a scheduled job.
