# Google OAuth for Sheets import/export. See docs/google-oauth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the app, no trailing slash. Redirect URI = ${APP_URL}/api/google/callback
APP_URL=
# 32 random bytes, base64. Encrypts OAuth tokens at rest (AES-256-GCM) and signs the OAuth state.
TOKEN_ENCRYPTION_KEY=
